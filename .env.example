# ---- App ----
APP_ENV=dev
APP_HOST=0.0.0.0
APP_PORT=8000

# ---- Database ----
DB_HOST=localhost
DB_PORT=5432
DB_NAME=news_aggregator
DB_USER=news
DB_PASSWORD=changeme
DB_URL=postgresql+asyncpg://news:changeme@localhost:5432/news_aggregator

# ---- DeepSeek (LLM) ----
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_RAG_DAILY_LIMIT=200

# ---- NewsAPI.org ----
NEWSAPI_API_KEY=

# ---- RSS Feeds (comma-free, newline separated list in configs/feeds.yaml) ----
# ---- Embedding / reranker (local) ----
EMBEDDING_MODEL=BAAI/bge-small-zh
RERANKER_MODEL=BAAI/bge-reranker-base

# ---- Dedup ----
DEDUP_SIM_THRESHOLD=0.90
DEDUP_PRECISION_TARGET=0.9